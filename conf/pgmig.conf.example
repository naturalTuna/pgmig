# pgmig 설정 (bash 문법). 실행할 때마다 다시 읽음 -> 값 고치고 같은 명령 다시 실행하면 적용. 복사해서 conf/pgmig.conf 로 저장. 비밀번호가 들어가니 chmod 600

# ---- target PostgreSQL (psql 표준 환경변수. superuser 로 접속) ----
PGHOST=/tmp
PGPORT=5432
PGDATABASE=experdb
PGUSER=postgres
#PGPASSWORD=

# ---- source ----
SRC_TYPE=oracle                       # oracle | postgres(selftest 용)
SRC_DBSERVER='//10.0.0.5:1521/ORCL'   # oracle 접속 문자열 (EZConnect 또는 tnsnames 별칭)
SRC_USER=system
SRC_PASSWORD='change_me'
SRC_SCHEMAS='HR,SCOTT'                # 이관할 소스 스키마. 오라클은 대문자
#SCHEMA_MAP='HR:hr_new'               # target 스키마 이름을 바꿀 때만 (기본: 소문자로)
#EXCLUDE_TABLES='HR.TMP_%,HR.BACKUP_%' # 제외할 테이블 (SCHEMA.TABLE, LIKE 패턴)

# postgres 소스일 때만
#SRC_PG_HOST=localhost
#SRC_PG_PORT=5432
#SRC_PG_DBNAME=srcdb

# ---- 실행 ----
JOBS=4                 # 병렬 세션 수 (이관/인덱스/검증 공통)
CHUNK_ROWS=500000      # 숫자 PK(단일 또는 복합 PK 의 숫자 선두 컬럼) 테이블을 이 행 수 단위로 쪼갬
#CHUNK_SPLIT=quantile  # quantile(기본) = 소스 PK 분위수로 경계 (ID 가 치우쳐도 청크 크기 균일)
                       # uniform = (max-min)/n 균등 분할 (소스에서 PK 정렬 1회도 아끼고 싶을 때)
#CHUNK_ALWAYS_COUNT=on # 소스 통계(num_rows)를 못 믿을 때: 항상 실제 count 로 청크 계산
#SPLIT_COLS='HR.ACCESS_LOG:LOG_TIME,HR.EVENTS:SEQ_NO'
                       # 숫자 PK 가 없는(또는 PK 대신 쓸) 큰 테이블의 분할 컬럼. SCHEMA.TABLE:컬럼, 숫자/DATE/TIMESTAMP
                       # 중복/NULL 있어도 됨 (NULL 은 첫 청크). schema(청크 계획) 전에 설정
VERIFY_MODE=full       # full = 건수 + 전 컬럼 해시 (소스를 한 번 더 읽음) / count = 건수만
PROGRESS_SEC=5

# ---- 마감 (매일 정해진 시간만 이관할 때. data/verify/repair/sync/run 에 적용, 명령행 옵션이 우선) ----
#UNTIL=04:00           # 이 시각까지 (지난 시각이면 다음 날). 명령행: --until 04:00
#MAX_MINUTES=180       # 지금부터 N 분까지 (UNTIL 과 같이 쓰면 빠른 쪽). 명령행: --max-minutes 180
#STOP_BEFORE_MIN=10    # 마감 N 분 전부터 새 청크 시작 안 함 (진행 중 청크는 끝까지). 명령행: --stop-before 10

# ---- oracle 옵션 ----
ORA_DICT=all           # all = ALL_* 뷰 / dba = DBA_* 뷰 (SELECT ANY DICTIONARY 필요)
ORA_USE_SCN=off        # on = 모든 청크를 같은 SCN 시점으로 읽음 (flashback query).
                       #      소스가 운영 중일 때 일관성 확보용. FLASHBACK 권한 + undo 보존 필요
#ORA_SCN=              # SCN 을 직접 지정할 때
ORA_PREFETCH=1000      # 한 번에 가져오는 행 수 (1~10240)
#ORA_LOB_PREFETCH=     # LOB 선행 fetch 바이트 (oracle_fdw 가 지원하는 버전에서만)
ORA_MAX_LONG=32767     # LONG / LONG RAW / XMLTYPE 최대 길이. 넘으면 에러로 멈춤 (조용히 안 잘림)
ORA_STRIP_ZEROS=off    # on = 문자열 안의 0x00 문자를 제거하고 이관 (데이터가 바뀌는 것이므로 기본 off)
ORA_PARTITIONS=on      # on = 오라클 파티션 정의를 PostgreSQL 선언적 파티션으로 생성 / off = 일반 테이블로
ORA_ISOLATION_LEVEL=serializable
